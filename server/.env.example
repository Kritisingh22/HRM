# ---- copy this file to ".env" and fill in real values ----
NODE_ENV=development
PORT=5000

# MongoDB connection string.
#  - Local:  mongodb://127.0.0.1:27017/cyethack_hr
#  - Atlas:  mongodb+srv://<user>:<pass>@<cluster>/cyethack_hr
MONGODB_URI=mongodb://127.0.0.1:27017/cyethack_hr

# JWT secrets — use two DIFFERENT long random strings.
# Generate each with:  openssl rand -base64 48
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Token lifetimes
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Where the frontend is served from (for CORS). The bundled portal is served
# from this same server, so the default is fine for local use.
FRONTEND_URL=http://localhost:5000

# Account lockout after repeated failed logins
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15

# One-time setup token for creating the FIRST admin via POST /api/auth/bootstrap-admin.
# Bootstrap requires BOTH this token (sent as the X-Setup-Token header or a setupToken
# body field) AND an empty user database. Generate a real one with: openssl rand -base64 32
# In production the server REFUSES to start if this is left as the placeholder below or
# is shorter than 16 characters. Leave it BLANK to disable bootstrap entirely
# (recommended once your admin exists). NEVER expose this value in frontend code.
SETUP_TOKEN=change-this-to-a-long-random-secret

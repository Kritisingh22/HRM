# --- Git ---
.git

# --- Dependencies (installed at image build time with npm ci) ---
node_modules
client/node_modules
server/node_modules

# --- Build output (regenerated by the Dockerfile frontend stage) ---
client/dist
client/build
server/dist

# --- Environment files (never copy secrets into the image) ---
.env
.env.local
.env.*.local
server/.env
server/.env.*

# --- Runtime data (uploads is a mounted volume in production) ---
server/uploads/*
!server/uploads/.gitkeep

# --- Logs, test artifacts, reports, OS/editor cruft ---
*.log
npm-debug.log*
logs/
coverage/
INTEGRATION_REPORT.md
PAYSLIP_PDF_FIX_REPORT.md
LIGHTHOUSE_QA_FIX_REPORT.md
test_*.pdf
*.test.pdf
test_payslip.pdf
debug-leave.js
server/debug-leave.js
check-paths.js
.DS_Store
Thumbs.db
.vscode/
.idea/

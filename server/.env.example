# ---- copy this file to ".env" and fill in real values ----
NODE_ENV=development
PORT=5000

# MongoDB connection string.
#  - Local:  mongodb://127.0.0.1:27017/cyethack_hr
#  - Atlas:  mongodb+srv://<user>:<pass>@<cluster>/cyethack_hr
MONGODB_URI=mongodb://127.0.0.1:27017/cyethack_hr

# JWT secrets — use two DIFFERENT long random strings.
# Generate each with:  openssl rand -base64 48
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Token lifetimes
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Where the frontend is served from (for CORS). The bundled portal is served
# from this same server, so the default is fine for local use.
FRONTEND_URL=http://localhost:5000

# Account lockout after repeated failed logins
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15

# One-time setup token for creating the FIRST admin via POST /api/auth/bootstrap-admin.
# Bootstrap requires BOTH this token (sent as the X-Setup-Token header or a setupToken
# body field) AND an empty user database. Generate a real one with: openssl rand -base64 32
# In production the server REFUSES to start if a configured token is the old placeholder or
# shorter than 16 characters. Leave it BLANK to disable bootstrap entirely
# (recommended once your admin exists). NEVER expose this value in frontend code.
SETUP_TOKEN=

# =====================================================================
# Document storage (Google Drive object storage for uploaded files)
# =====================================================================
# Bytes are stored OUTSIDE the repository/database; MongoDB keeps only metadata
# plus the Drive file ID. Files/folders remain private — nobody reaches them
# except through this server's authenticated endpoints. Never commit keys.
#
# DOCUMENT_STORAGE: local | google-drive. Leave unset for automatic selection
# (Google Drive when fully configured below, local disk otherwise).
# DOCUMENT_STORAGE=google-drive
#
# The PRIVATE Google Drive folder that holds uploaded documents (the URL
# fragment after /folders/). Grant the identity below access to THIS folder —
# never make the folder or its files public.
# GOOGLE_DRIVE_FOLDER_ID=1wSFwgRHgE50UB2W2mcZIiFyB_N5MlRXX
#
# Auth mode: service_account (default) or oauth.
# service_account: save the JSON key OUTSIDE version control, e.g.
#   server/secrets/gdrive-sa.json (gitignored), and share the folder above with
#   the key's client_email as Editor.
# GOOGLE_DRIVE_AUTH_MODE=service_account
# GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/gdrive-sa.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}   # inline alternative
#
# OAuth alternative (files are owned by the consenting user instead):
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
#
# Optional: a dedicated subfolder used ONLY by storage checks / live tests.
# GOOGLE_DRIVE_TEST_FOLDER_ID=
#
# Upload guardrails
# UPLOAD_MAX_MB=10
# UPLOAD_ALLOWED_MIME=                                  # EXTRA comma-separated MIME types
# UPLOAD_RESUMABLE_THRESHOLD_MB=5                       # larger files use resumable uploads
# UPLOAD_RATE_MAX=30
# UPLOAD_RATE_WINDOW_MIN=15
#
# Archive each payslip PDF the moment HR processes it (the on-demand
# POST /api/payroll/:id/payslip/archive endpoint works either way).
# PAYSLIP_ARCHIVE_TO_DRIVE=false

# ---- Official company details rendered on generated documents (payslip PDF) ----
# Only the name is shown by default; the address / email / phone / website rows
# appear on the payslip header ONLY when configured here (nothing is invented).
# COMPANY_NAME=CYETHACK Solution
# COMPANY_ADDRESS=
# COMPANY_EMAIL=
# COMPANY_PHONE=
# COMPANY_WEBSITE=
# Currency used for every amount on the payslip (ISO code — the PDF uses the
# code, e.g. "INR 25,000.00", because the built-in PDF fonts cannot render ₹).
PAYROLL_CURRENCY=INR

# Vite exposes only VITE_* variables to the client.

# Set VITE_SHOW_DEMO_ACCOUNTS=true to reveal the seeded demo accounts on the
# login card (local/dev previews only).
#
# Unset this in production — any value other than exactly "true" keeps demo
# accounts hidden. The login card reads import.meta.env.VITE_SHOW_DEMO_ACCOUNTS
# at build time, so no deploy-time change is needed once it is unset.
VITE_SHOW_DEMO_ACCOUNTS=
